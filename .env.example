# Copy to .env and fill in real values. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=farmaid
DB_USER=farmaid
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/farmaid
# At least 32 random bytes, base64 encoded:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MINUTES=300
CORS_ALLOWED_ORIGINS=http://localhost:4200
ADMIN_EMAIL=admin@farmaid.local
ADMIN_PASSWORD=Admin@12345
